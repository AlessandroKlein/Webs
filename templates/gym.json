{
  "id": "gym",
  "name": "Gimnasio",
  "description": "Plataforma para gimnasios y cadenas: membresías, clases/reservas, tienda, inventario, rutinas, chat, red social y analíticas.",
  "blocks": [
    { "id": "organizaciones", "config": { "multiTenant": true, "shareInventory": false, "shareMembers": false } },
    { "id": "reservas", "config": { "provider": "local", "reminderEmail": true, "leadTimeHours": 1, "cancelPolicyHours": 12 } },
    { "id": "calendario", "config": { "provider": "local", "timezone": "America/Argentina/Buenos_Aires" } },
    { "id": "ecommerce", "config": { "shippingProvider": "flat", "originCountry": "AR" } },
    { "id": "inventario", "config": { "lowStockThreshold": 5, "trackBySku": true } },
    { "id": "carrito", "config": {} },
    { "id": "mercadopago", "config": {} },
    { "id": "facturacion", "config": { "afipMode": "factura", "arcaEnvironment": "homol" } },
    { "id": "academia", "config": { "allowEnroll": true, "certificateEnabled": false } },
    { "id": "chat", "config": { "allowCommunities": true, "moderation": "basic" } },
    { "id": "social", "config": { "allowImages": true, "enableLikes": true } },
    { "id": "analytics", "config": { "provider": "internal", "trackPageViews": true } },
    { "id": "notificaciones", "config": {} },
    { "id": "support", "config": {} }
  ],
  "settings": {
    "site": { "name": "Mi Gimnasio", "tagline": "Entrená sin límites" },
    "appearance": { "primaryColor": "#16a34a", "defaultTheme": "light" }
  },
  "menu": [
    { "label": "Inicio", "path": "/", "order": 0 },
    { "label": "Clases", "path": "/clases", "order": 1 },
    { "label": "Planes", "path": "/planes", "order": 2 },
    { "label": "Tienda", "path": "/tienda", "order": 3 },
    { "label": "Rutinas", "path": "/rutinas", "order": 4 },
    { "label": "Comunidad", "path": "/comunidad", "order": 5 }
  ]
}
