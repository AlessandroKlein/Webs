{
  "id": "logistica",
  "name": "Centro de logística",
  "description": "Gestión de depósitos y envíos: inventario por SKU, órdenes, transportistas (Andreani, OCA, Correo Argentino, MercadoLibre), POS/código de barras, remitos con firma, flujos de trabajo, facturación y analíticas.",
  "blocks": [
    { "id": "organizaciones", "config": { "defaultPlan": "free", "requireApproval": false, "shareInventoryByDefault": true } },
    { "id": "inventario", "config": { "lowStockThreshold": 5, "trackBySku": true } },
    { "id": "ecommerce", "config": { "enableShippingProviders": true, "shippingProvider": "local" } },
    { "id": "pos", "config": { "mode": "terminal" } },
    { "id": "documentos", "config": { "requireSignature": true, "auditTrail": true } },
    { "id": "workflows", "config": { "defaultEnabled": true } },
    { "id": "andreani" },
    { "id": "oca" },
    { "id": "correo" },
    { "id": "mercadolibre" },
    { "id": "storage-s3" },
    { "id": "facturacion", "config": { "afipMode": "factura", "arcaEnvironment": "homol" } },
    { "id": "notificaciones" },
    { "id": "analytics", "config": { "provider": "internal", "trackPageViews": true } },
    { "id": "support" }
  ],
  "settings": {
    "site": { "name": "Mi Logística", "tagline": "Depósitos y envíos bajo control" },
    "appearance": { "primaryColor": "#0f766e", "defaultTheme": "light" }
