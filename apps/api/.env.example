# =============================================================
# Webs API — variables de entorno
# Copiar a .env y ajustar. Ver apps/api/src/config/env.ts para el esquema.
# =============================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# PostgreSQL / SQLite / MySQL
# En una instalación nueva, DEJALO vacío: la base se configura desde el
# asistente de instalación (UI) y queda guardada en data/webs.config.json.
# DATABASE_URL=postgresql://webs:webs@localhost:5432/webs?schema=public
# DATABASE_URL=file:./data/webs.db

# Redis (opcional en dev; recomendado para sesiones, caché y WebSocket en cluster)
# REDIS_URL=redis://localhost:6379

# JWT (usar valores largos y aleatorios en producción: `openssl rand -hex 32`)
JWT_SECRET=dev-secret-change-me-please-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# TLS / HTTPS (opcional). Si SSL_ENABLED=true, indicar ruta de certificado/clave
# (o pegar el PEM en SSL_CERT / SSL_KEY para secretos de K8s).
SSL_ENABLED=false
# SSL_CERT_PATH=/etc/ssl/certs/webs.crt
# SSL_KEY_PATH=/etc/ssl/private/webs.key
# SSL_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# SSL_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Directorio de bloques locales (relativo a la raíz del monorepo). Opcional.
BLOCK_DIR=../../blocks

# URL del índice remoto del marketplace (JSON). Opcional; si no, se usa blocks/catalog.json.
# BLOCK_REGISTRY_URL=https://raw.githubusercontent.com/tu-usuario/tu-registro/main/catalog.json

# Seed del primer superadmin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme
