{
  "name": "@webs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST + WebSocket de la plataforma Webs (Fastify).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma",
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/sensible": "^6.0.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/websocket": "^11.0.1",
    "@licensify/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.600.0",
    "@prisma/client": "^6.0.0",
    "@simplewebauthn/server": "^10.0.0",
    "@simplewebauthn/types": "^10.0.0",
    "@webs/core": "workspace:*",
    "@webs/i18n": "workspace:*",
    "@webs/plugin-sdk": "workspace:*",
    "ajv": "^8.17.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.15",
    "otplib": "^12.0.1",
    "pino": "^9.4.0",
    "rate-limiter-flexible": "^5.0.3",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/sanitize-html": "^2.13.0",
    "@types/ws": "^8.5.12",
    "@webs/config": "workspace:*",
    "eslint": "^9.13.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^6.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
