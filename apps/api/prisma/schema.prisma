// Prisma schema — base de datos de la plataforma Webs.
// Documentación de referencia: https://www.prisma.io/docs/orm/reference/prisma-schema-reference

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tipo de organización para el multi-tenant por cadenas (ADR-0006).
// - `standalone`: organización independiente (sin padre ni cadena).
// - `chain`:     raíz de una cadena (casa matriz).
// - `branch`:    sucursal (hija de una raíz o de otra sucursal).
enum OrganizationType {
  standalone
  chain
  branch
}

// Estados y prioridades del sistema de tickets (ADR-0021).
enum TicketStatus {
  pending
  in_progress
  done
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

// ---------------------------------------------------------------------------
// Identidad, roles y permisos
// ---------------------------------------------------------------------------

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  username             String?   @unique
  passwordHash         String
  displayName          String?
  firstName            String?
  lastName             String?
  birthDate            DateTime?
  avatarUrl            String?
  locale               String    @default("es")
  active               Boolean   @default(true)
  profile              Json?
  emailVerifiedAt      DateTime?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorBackupCodes Json?
  twoFactorPhone       String?
  twoFactorSmsEnabled  Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  roles     UserRole[]
  sessions  Session[]
  apiTokens ApiToken[]
  passkeys  Passkey[]
  payments  Payment[]
  expenses  Expense[]
  otpCodes  OtpCode[]
  auditLogs AuditLog[]
  content   Content[]  @relation("ContentAuthor")
  settings  Setting[]  @relation("SettingEditor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@map("sessions")
}

model ApiToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  scopes       Json      @default("[]")
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  rateLimit    Int?
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@map("api_tokens")
}

model Passkey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   Json      @default("[]")
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkeys")
}

model OtpCode {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Expense {
  id             String   @id @default(uuid())
  description    String
  amount         Int
  category       String?
  date           DateTime @default(now())
  organizationId String
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([date])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Negocio (datos persistentes de los bloques: ecommerce, reservas, blog, LMS…)
// ---------------------------------------------------------------------------

model Product {
  id             String  @id @default(uuid())
  organizationId String
  title          String
  description    String?
  price          Int
  stock          Int     @default(0)
  category       String?
  imageUrl       String?
  images         Json    @default("[]")
  sizes          Json    @default("[]")
  barcode        String?
  categoryId     String?
  brandId        String?
  supplierId     String?

  categoryRef Category?    @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  brandRef    Brand?       @relation("ProductBrand", fields: [brandId], references: [id], onDelete: SetNull)
  supplierRef Supplier?    @relation("ProductSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  variants    Variant[]
  stockLevels StockLevel[]

  @@index([organizationId])
  @@map("products")
}

model Order {
  id             String   @id @default(uuid())
  organizationId String
  status         String   @default("pending")
  total          Int      @default(0)
  items          Json     @default("[]")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("orders")
}

model Booking {
  id             String   @id @default(uuid())
  organizationId String
  serviceId      String
  name           String
  date           DateTime
  status         String   @default("confirmed")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([date])
  @@map("bookings")
}

model BlogPost {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  body           String
  category       String?
  tags           Json     @default("[]")
  status         String   @default("draft")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("blog_posts")
}

model Course {
  id             String  @id @default(uuid())
  organizationId String
  title          String
  description    String?
  level          String?
  lessons        Json    @default("[]")

  @@index([organizationId])
  @@map("courses")
}

model Enrollment {
  id             String    @id @default(uuid())
  organizationId String
  courseId       String
  student        String
  progress       Int       @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([courseId])
  @@map("enrollments")
}

model Routine {
  id             String   @id @default(uuid())
  organizationId String
  trainerId      String
  memberId       String
  name           String
  description    String?
  exercises      Json     @default("[]")
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([trainerId])
  @@index([memberId])
  @@map("routines")
}

model Comment {
  id             String   @id @default(uuid())
  organizationId String
  author         String
  body           String
  rating         Int      @default(5)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("comments")
}

model Ticket {
  id               String         @id @default(uuid())
  organizationId   String
  subject          String
  message          String
  status           TicketStatus   @default(pending)
  priority         TicketPriority @default(normal)
  assignedToUserId String?
  authorId         String?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId])
  @@index([status])
  @@map("tickets")
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String?
  title          String
  body           String
  read           Boolean   @default(false)
  priority       String    @default("normal")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@map("notifications")
}

model ChatMessage {
  id             String   @id @default(uuid())
  organizationId String
  from           String
  to             String   @default("general")
  body           String
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([to, createdAt])
  @@map("chat_messages")
}

model CalendarEvent {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  start          DateTime
  end            DateTime?
  type           String?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([start])
  @@map("calendar_events")
}

model SocialPost {
  id             String   @id @default(uuid())
  organizationId String
  author         String
  text           String
  mediaUrl       String?
  mediaType      String?
  likes          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([createdAt])
  @@map("social_posts")
}

model Follow {
  id             String   @id @default(uuid())
  organizationId String
  followerId     String
  followingId    String
  createdAt      DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([organizationId])
  @@index([followingId])
  @@map("follows")
}

model Story {
  id             String   @id @default(uuid())
  organizationId String
  author         String
  mediaUrl       String
  mediaType      String   @default("image")
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([organizationId])
  @@index([author, createdAt])
  @@map("stories")
}

model Subscription {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  planId         String
  planName       String    @default("")
  status         String    @default("active")
  startDate      DateTime  @default(now())
  endDate        DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([planId])
  @@map("subscriptions")
}

model Organization {
  id             String           @id @default(uuid())
  name           String
  slug           String?          @unique
  domain         String?          @unique
  plan           String           @default("free")
  active         Boolean          @default(true)
  shareInventory Boolean          @default(false)
  logoUrl        String?
  type           OrganizationType @default(standalone)
  parentId       String?
  chainId        String?
  parent         Organization?    @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Organization[]   @relation("OrgHierarchy")
  chainRoot      Organization?    @relation("OrgChain", fields: [chainId], references: [id], onDelete: SetNull)
  chainBranches  Organization[]   @relation("OrgChain")
  warehouses     Warehouse[]
  createdAt      DateTime         @default(now())

  @@index([parentId])
  @@index([chainId])
  @@index([type])
  @@map("organizations")
}

model Membership {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  role           String    @default("member")
  plan           String    @default("free")
  status         String    @default("active")
  startDate      DateTime  @default(now())
  endDate        DateTime?
  qrcode         String?   @unique
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model MembershipPlan {
  id           String   @id @default(uuid())
  name         String
  price        Int      @default(0)
  durationDays Int      @default(30)
  features     Json     @default("[]")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("membership_plans")
}

model AttendanceRecord {
  id             String   @id @default(uuid())
  organizationId String
  membershipId   String
  userId         String
  method         String   @default("qr")
  timestamp      DateTime @default(now())

  @@index([organizationId])
  @@index([membershipId])
  @@index([timestamp])
  @@map("attendance_records")
}

model InventoryItem {
  id             String   @id @default(uuid())
  organizationId String
  sku            String
  name           String
  quantity       Int      @default(0)
  minQuantity    Int      @default(0)
  unitPrice      Int      @default(0)
  category       String?
  productId      String?
  barcode        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([sku])
  @@index([barcode])
  @@map("inventory_items")
}

model Form {
  id        String   @id @default(uuid())
  title     String
  fields    Json     @default("[]")
  createdAt DateTime @default(now())

  @@map("forms")
}

model FormResponse {
  id        String   @id @default(uuid())
  formId    String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([formId])
  @@map("form_responses")
}

model Document {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  content   String   @default("")
  signed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("documents")
}

model Workflow {
  id        String   @id @default(uuid())
  name      String
  trigger   String
  steps     Json     @default("[]")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("workflows")
}

model Affiliate {
  id         String   @id @default(uuid())
  userId     String
  code       String   @unique
  commission Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("affiliates")
}

model Referral {
  id          String   @id @default(uuid())
  affiliateId String
  email       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@map("referrals")
}

model SocialAccount {
  id         String   @id @default(uuid())
  userId     String?
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@map("social_accounts")
}

model Invite {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  role      String    @default("user")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("invites")
}

model Page {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  layout      Json     @default("[]")
  redirectUrl String?
  isHome      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

// ---------------------------------------------------------------------------
// Configuración, bloques y colocaciones
// ---------------------------------------------------------------------------

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  schemaKey   String?
  updatedById String?
  updatedBy   User?    @relation("SettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model PluginInstallation {
  id          String   @id @default(uuid())
  pluginId    String   @unique
  name        String
  version     String
  enabled     Boolean  @default(true)
  config      Json     @default("{}")
  manifest    Json
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("plugin_installations")
}

model PluginPlacement {
  id        String   @id @default(uuid())
  pluginId  String
  slotId    String
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slotId])
  @@map("plugin_placements")
}

// ---------------------------------------------------------------------------
// Contenido, traducciones, menús y medios
// ---------------------------------------------------------------------------

model Content {
  id          String    @id @default(uuid())
  type        String    @default("page")
  slug        String
  title       Json
  body        Json?
  status      String    @default("draft")
  seo         Json?
  authorId    String?
  author      User?     @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([type, slug])
  @@map("content")
}

model Translation {
  id        String   @id @default(uuid())
  locale    String
  namespace String   @default("translation")
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@map("translations")
}

model Menu {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menus")
}

model Media {
  id             String   @id @default(uuid())
  key            String   @unique
  mimeType       String
  size           Int
  url            String
  alt            String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Email: plantillas, campañas, automatizaciones y cola de envío
// ---------------------------------------------------------------------------

model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  bodyMode  String   @default("wysiwyg")
  variables Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns   EmailCampaign[]
  automations EmailAutomation[]
  messages    EmailMessage[]

  @@map("email_templates")
}

model EmailCampaign {
  id              String         @id @default(uuid())
  name            String
  subject         String?
  templateId      String?
  template        EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientType   String         @default("all")
  recipientRoles  Json           @default("[]")
  recipientEmails Json           @default("[]")
  status          String         @default("draft")
  scheduledAt     DateTime?
  sentCount       Int            @default(0)
  totalCount      Int            @default(0)
  openCount       Int            @default(0)
  clickCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("email_campaigns")
}

model EmailAutomation {
  id         String         @id @default(uuid())
  name       String
  event      String
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  enabled    Boolean        @default(true)
  conditions Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("email_automations")
}

model EmailMessage {
  id         String         @id @default(uuid())
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  to         String
  subject    String
  body       String
  status     String         @default("queued")
  error      String?
  campaignId String?
  sentAt     DateTime?
  openedAt   DateTime?
  clickCount Int            @default(0)
  createdAt  DateTime       @default(now())
  clicks     EmailClick[]

  @@index([status])
  @@map("email_messages")
}

model EmailClick {
  id        String       @id @default(uuid())
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String?
  clickedAt DateTime     @default(now())

  @@index([messageId])
  @@index([clickedAt])
  @@map("email_clicks")
}

// ---------------------------------------------------------------------------
// Pagos
// ---------------------------------------------------------------------------

model Payment {
  id                String    @id @default(uuid())
  organizationId    String
  provider          String
  transactionId     String    @unique
  amount            Int
  currency          String    @default("ARS")
  status            String    @default("pending")
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  externalReference String?
  idempotencyKey    String?
  metadata          Json?
  errorMessage      String?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId])
  @@index([provider])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Facturación, envíos y cupones (bloques facturacion/ecommerce/marketing)
// ---------------------------------------------------------------------------

model Invoice {
  id              String    @id @default(uuid())
  organizationId  String
  number          String    @unique
  type            String    @default("invoice")
  amount          Int       @default(0)
  neto            Int?
  iva             Int?
  currency        String    @default("ARS")
  status          String    @default("draft")
  customerName    String?
  customerTaxId   String?
  vatCondition    String?
  customerAddress String?
  ptoVta          Int       @default(1)
  cbteTipo        Int       @default(1)
  cae             String?
  caeExpiresAt    DateTime?
  caePeriodo      String?
  caeOrden        Int?
  orderId         String?
  userId          String?
  template        String?
  pdfUrl          String?
  paymentId       String?
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([createdAt])
  @@index([ptoVta, cbteTipo])
  @@index([userId])
  @@map("invoices")
}

model Shipment {
  id             String   @id @default(uuid())
  organizationId String
  orderId        String
  provider       String
  trackingNumber String?
  status         String   @default("pending")
  cost           Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([orderId])
  @@map("shipments")
}

model Coupon {
  id              String    @id @default(uuid())
  organizationId  String
  code            String    @unique
  discountPercent Int       @default(0)
  validUntil      DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@map("coupons")
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Licencias (venta) — registro local offline de ventas y claves de activación
// ---------------------------------------------------------------------------

model LicenseSale {
  id             String       @id @default(uuid())
  organizationId String
  customerName   String
  customerEmail  String?
  productId      String
  features       Json         @default("[]")
  limits         Json?
  amount         Int?
  currency       String       @default("ARS")
  notes          String?
  soldAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  keys           LicenseKey[]

  @@index([organizationId])
  @@index([productId])
  @@map("license_sales")
}

model LicenseKey {
  id             String       @id @default(uuid())
  organizationId String
  saleId         String?
  sale           LicenseSale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  productId      String
  licensee       String
  features       Json         @default("[]")
  limits         Json?
  fingerprint    String?
  activationKey  String       @unique
  status         String       @default("active")
  issuedAt       DateTime     @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([productId])
  @@map("license_keys")
}

// Recurso generado por el motor de APIs (ADR-0020): define el schema (JSON Schema)
// de una colección de datos creada por el usuario sin código.
model GeneratedResource {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  schema      Json
  description String?
  feature     String   @default("generator")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("generated_resources")
}

// Registro de datos de un recurso generado (scoped por organización, ADR-0006).
// `resourceId` referencia el `key` de un GeneratedResource (relación lógica, sin FK).
model GeneratedRecord {
  id             String   @id @default(uuid())
  resourceId     String
  organizationId String
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([resourceId, organizationId])
  @@map("generated_records")
}

// ---------------------------------------------------------------------------
// Inventario completo (M9 — ADR-0023). Modelo core: variantes, catálogo,
// almacenes por sucursal y niveles de stock. Importes en centavos (Int).
// ---------------------------------------------------------------------------

// Variante de producto (SKU/EAN-UPC + atributos). `sku`/`barcode` son únicos
// por organización (no globales). El stock se contabiliza siempre por variante.
model Variant {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  sku            String
  barcode        String?
  name           String
  attributes     Json     @default("{}")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([productId])
  @@map("variants")
}

// Categoría de producto (jerárquica). El texto libre legado `Product.category`
// se migra aquí y luego se elimina.
model Category {
  id             String     @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  active         Boolean    @default(true)
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryTree")
  products       Product[]  @relation("ProductCategory")
  createdAt      DateTime   @default(now())

  @@index([organizationId])
  @@index([parentId])
  @@map("inventory_categories")
}

model Brand {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  active         Boolean   @default(true)
  products       Product[] @relation("ProductBrand")
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@map("inventory_brands")
}

model Supplier {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  active         Boolean   @default(true)
  products       Product[] @relation("ProductSupplier")
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@map("inventory_suppliers")
}

// Almacén ligado a una organización/sucursal. Con `shareInventory=true` se
// asocia a la raíz de la cadena (ADR-0006). `isDefault` recibe el stock cuando
// la operación no especifica almacén.
model Warehouse {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels  StockLevel[]

  @@index([organizationId])
  @@map("inventory_warehouses")
}

// Nivel de stock por producto(+variante) y almacén, con umbrales mínimo/crítico
// y costo promedio ponderado (centavos). Único por (almacén, producto, variante).
model StockLevel {
  id               String   @id @default(uuid())
  organizationId   String
  warehouseId      String
  productId        String
  variantId        String?
  quantity         Int      @default(0)
  minQuantity      Int      @default(0)
  criticalQuantity Int      @default(0)
  averageCost      Int      @default(0)
  updatedAt        DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   Variant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([organizationId])
  @@index([warehouseId])
  @@map("inventory_stock_levels")
}

model StockMovement {
  id             String   @id @default(uuid())
  organizationId String
  warehouseId    String
  productId      String
  variantId      String?
  type           String // entrada | salida | ajuste | transferencia
  quantity       Int // delta: + entrada, - salida
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  userId         String
  referenceType  String? // venta | compra | ajuste | transferencia
  referenceId    String?
  unitCost       Int? // costo de la operación (centavos)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([warehouseId])
  @@index([productId, variantId])
  @@index([referenceType, referenceId])
  @@map("inventory_stock_movements")
}

model InventoryLot {
  id           String   @id @default(uuid())
  stockLevelId String
  quantity     Int
  unitCost     Int
  receivedAt   DateTime @default(now())

  @@index([stockLevelId, receivedAt])
  @@map("inventory_lots")
}
