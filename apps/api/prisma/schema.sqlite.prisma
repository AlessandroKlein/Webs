// Prisma schema — base de datos de la plataforma Webs.
// Documentación de referencia: https://www.prisma.io/docs/orm/reference/prisma-schema-reference

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidad, roles y permisos
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String?   @unique
  passwordHash    String
  displayName     String?
  avatarUrl       String?
  locale          String    @default("es")
  active          Boolean   @default(true)
  emailVerifiedAt DateTime?
  twoFactorSecret String?
  twoFactorEnabled Boolean  @default(false)
  twoFactorBackupCodes Json?
  twoFactorPhone   String?
  twoFactorSmsEnabled Boolean @default(false)
  failedLoginAttempts Int @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles      UserRole[]
  sessions   Session[]
  apiTokens  ApiToken[]
  passkeys   Passkey[]
  payments   Payment[]
  expenses   Expense[]
  otpCodes   OtpCode[]
  auditLogs  AuditLog[]
  content    Content[]   @relation("ContentAuthor")
  settings   Setting[]   @relation("SettingEditor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@map("sessions")
}

model ApiToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  scopes       Json      @default("[]")
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  rateLimit    Int?
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@map("api_tokens")
}

model Passkey {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   Json     @default("[]")
  deviceName   String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkeys")
}

model OtpCode {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Int
  category    String?
  date        DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Negocio (datos persistentes de los bloques: ecommerce, reservas, blog, LMS…)
// ---------------------------------------------------------------------------

model Product {
  id       String  @id @default(uuid())
  title    String
  price    Int
  stock    Int     @default(0)
  category String?

  @@map("products")
}

model Order {
  id        String   @id @default(uuid())
  status    String   @default("pending")
  total     Int      @default(0)
  items     Json     @default("[]")
  createdAt DateTime @default(now())

  @@map("orders")
}

model Booking {
  id        String   @id @default(uuid())
  serviceId String
  name      String
  date      DateTime
  status    String   @default("confirmed")
  createdAt DateTime @default(now())

  @@index([date])
  @@map("bookings")
}

model BlogPost {
  id        String   @id @default(uuid())
  title     String
  body      String
  category  String?
  tags      Json     @default("[]")
  status    String   @default("draft")
  createdAt DateTime @default(now())

  @@map("blog_posts")
}

model Course {
  id          String  @id @default(uuid())
  title       String
  description String?
  level       String?
  lessons     Json    @default("[]")

  @@map("courses")
}

model Enrollment {
  id          String    @id @default(uuid())
  courseId    String
  student     String
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([courseId])
  @@map("enrollments")
}

model Comment {
  id        String   @id @default(uuid())
  author    String
  body      String
  rating    Int      @default(5)
  createdAt DateTime @default(now())

  @@map("comments")
}

model Ticket {
  id        String   @id @default(uuid())
  subject   String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@map("tickets")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model ChatMessage {
  id        String   @id @default(uuid())
  from      String
  to        String   @default("general")
  body      String
  createdAt DateTime @default(now())

  @@index([to, createdAt])
  @@map("chat_messages")
}

model CalendarEvent {
  id        String   @id @default(uuid())
  title     String
  start     DateTime
  end       DateTime?
  type      String?
  createdAt DateTime @default(now())

  @@index([start])
  @@map("calendar_events")
}

model SocialPost {
  id        String   @id @default(uuid())
  author    String
  text      String
  mediaUrl  String?
  mediaType String?
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("social_posts")
}

model Organization {
  id             String   @id @default(uuid())
  name           String
  slug           String?  @unique
  plan           String   @default("free")
  active         Boolean  @default(true)
  shareInventory Boolean  @default(false)
  logoUrl        String?
  createdAt      DateTime @default(now())

  @@map("organizations")
}

model Membership {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  role           String    @default("member")
  plan           String    @default("free")
  status         String    @default("active")
  startDate      DateTime  @default(now())
  endDate        DateTime?
  qrcode         String?   @unique
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model MembershipPlan {
  id           String   @id @default(uuid())
  name         String
  price        Int      @default(0)
  durationDays Int      @default(30)
  features     Json     @default("[]")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("membership_plans")
}

model AttendanceRecord {
  id             String   @id @default(uuid())
  organizationId String
  membershipId   String
  userId         String
  method         String   @default("qr")
  timestamp      DateTime @default(now())

  @@index([organizationId])
  @@index([membershipId])
  @@index([timestamp])
  @@map("attendance_records")
}

model InventoryItem {
  id             String   @id @default(uuid())
  organizationId String?
  sku            String
  name           String
  quantity       Int      @default(0)
  minQuantity    Int      @default(0)
  unitPrice      Int      @default(0)
  category       String?
  productId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([sku])
  @@map("inventory_items")
}

model Form {
  id        String   @id @default(uuid())
  title     String
  fields    Json     @default("[]")
  createdAt DateTime @default(now())

  @@map("forms")
}

model FormResponse {
  id        String   @id @default(uuid())
  formId    String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([formId])
  @@map("form_responses")
}

model Document {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  content   String   @default("")
  signed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("documents")
}

model Workflow {
  id        String   @id @default(uuid())
  name      String
  trigger   String
  steps     Json     @default("[]")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("workflows")
}

model Affiliate {
  id         String   @id @default(uuid())
  userId     String
  code       String   @unique
  commission Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("affiliates")
}

model Referral {
  id          String   @id @default(uuid())
  affiliateId String
  email       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@map("referrals")
}

model SocialAccount {
  id         String   @id @default(uuid())
  userId     String?
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@map("social_accounts")
}

model Invite {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  role      String    @default("user")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("invites")
}

model Page {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  layout      Json     @default("[]")
  redirectUrl String?
  isHome      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

// ---------------------------------------------------------------------------
// Configuración, bloques y colocaciones
// ---------------------------------------------------------------------------

model Setting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       Json
  schemaKey   String?
  updatedById String?
  updatedBy   User?     @relation("SettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("settings")
}

model BlockInstallation {
  id          String   @id @default(uuid())
  blockId     String   @unique
  name        String
  version     String
  enabled     Boolean  @default(true)
  config      Json     @default("{}")
  manifest    Json
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("block_installations")
}

model BlockPlacement {
  id        String   @id @default(uuid())
  blockId   String
  slotId    String
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slotId])
  @@map("block_placements")
}

// ---------------------------------------------------------------------------
// Contenido, traducciones, menús y medios
// ---------------------------------------------------------------------------

model Content {
  id          String    @id @default(uuid())
  type        String    @default("page")
  slug        String
  title       Json
  body        Json?
  status      String    @default("draft")
  seo         Json?
  authorId    String?
  author      User?     @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([type, slug])
  @@map("content")
}

model Translation {
  id        String   @id @default(uuid())
  locale    String
  namespace String   @default("translation")
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@map("translations")
}

model Menu {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menus")
}

model Media {
  id        String   @id @default(uuid())
  key       String   @unique
  mimeType  String
  size      Int
  url       String
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

// ---------------------------------------------------------------------------
// Email: plantillas, campañas, automatizaciones y cola de envío
// ---------------------------------------------------------------------------

model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  bodyMode  String   @default("wysiwyg")
  variables Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns   EmailCampaign[]
  automations EmailAutomation[]
  messages    EmailMessage[]

  @@map("email_templates")
}

model EmailCampaign {
  id              String         @id @default(uuid())
  name            String
  subject         String?
  templateId      String?
  template        EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientType   String         @default("all")
  recipientRoles  Json           @default("[]")
  recipientEmails Json           @default("[]")
  status          String         @default("draft")
  scheduledAt     DateTime?
  sentCount       Int            @default(0)
  totalCount      Int            @default(0)
  openCount       Int            @default(0)
  clickCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("email_campaigns")
}

model EmailAutomation {
  id         String         @id @default(uuid())
  name       String
  event      String
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  enabled    Boolean        @default(true)
  conditions Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("email_automations")
}

model EmailMessage {
  id         String         @id @default(uuid())
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  to         String
  subject    String
  body       String
  status     String         @default("queued")
  error      String?
  campaignId String?
  sentAt     DateTime?
  openedAt   DateTime?
  clickCount Int            @default(0)
  createdAt  DateTime       @default(now())
  clicks     EmailClick[]

  @@index([status])
  @@map("email_messages")
}

model EmailClick {
  id        String       @id @default(uuid())
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String?
  clickedAt DateTime     @default(now())

  @@index([messageId])
  @@index([clickedAt])
  @@map("email_clicks")
}

// ---------------------------------------------------------------------------
// Pagos
// ---------------------------------------------------------------------------

model Payment {
  id                String    @id @default(uuid())
  provider          String
  transactionId     String    @unique
  amount            Int
  currency          String    @default("ARS")
  status            String    @default("pending")
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  externalReference String?
  idempotencyKey    String?
  metadata          Json?
  errorMessage      String?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([provider])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
