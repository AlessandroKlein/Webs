{
  "name": "@webs/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA instalable de asistencia por QR (HTML + JS + Vite) y host Capacitor (Android/iOS) que envuelve apps/web.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:web": "pnpm --filter @webs/web build",
    "sync": "cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "copy": "cap copy"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/splash-screen": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "vite": "^6.0.0"
  }
}
