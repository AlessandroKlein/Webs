{
  "name": "@webs/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "App móvil de Webs (Android/iOS) con Capacitor: envuelve apps/web.",
  "scripts": {
    "build:web": "pnpm --filter @webs/web build",
    "sync": "cap sync",
    "add:android": "cap add android",
