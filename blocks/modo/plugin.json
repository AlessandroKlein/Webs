{
  "name": "@webs/block-modo",
  "id": "modo",
  "version": "0.1.0",
  "type": "plugin",
  "category": "pagos",
  "displayName": {
    "en": "MODO",
    "es": "MODO"
  },
  "description": {
    "en": "Payments via MODO (QR).",
    "es": "Pagos con MODO (QR)."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "provides": [
    "payment"
  ],
  "slots": [
    "payment"
  ],
  "events": [
    "mercadopago.payment.created",
    "mercadopago.payment.approved"
  ],
  "translations": {
    "es": {
      "pay": "Pagar con MODO"
    },
    "en": {
      "pay": "Pay with MODO"
    }
  },
  "settings": {
    "type": "object",
    "title": "Configuración de MODO",
    "properties": {
      "clientId": {
        "type": "string",
        "title": "Client ID",
        "x-ui": {
          "help": {
            "text": "Client ID de MODO para autenticar la creación de intenciones de pago (QR).",
            "url": "https://www.modo.com.ar/"
          }
        }
      },
      "clientSecret": {
        "type": "string",
        "title": "Client Secret",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Client Secret de MODO. Se usa solo en el servidor.",
            "url": "https://www.modo.com.ar/"
          }
        }
      },
      "webhookSecret": {
        "type": "string",
        "title": "Secreto del webhook",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Secreto para validar la firma del webhook. Si desactivás la verificación en Ajustes → Pagos, no se usa.",
            "url": "https://www.modo.com.ar/"
          }
        }
      },
      "environment": {
        "type": "string",
        "title": "Entorno",
        "enum": [
          "sandbox",
          "production"
        ],
        "default": "sandbox"
      },
      "primaryColor": {
        "type": "string",
        "title": "Color del botón",
        "x-ui": {
          "widget": "color"
        },
        "default": "#171717"
      }
    }
  }
}
