{
  "name": "@webs/block-envio-andreani",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bloque de envío Andreani.",
  "exports": {
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" }
  },
  "files": ["dist", "block.json"],
  "scripts": {
    "build": "tsup src/server.ts src/client.ts --format esm --dts --clean",
    "dev": "tsup src/server.ts src/client.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "dependencies": { "@webs/plugin-sdk": "workspace:*" },
  "devDependencies": {
    "@webs/config": "workspace:*",
    "eslint": "^9.13.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
