{
  "name": "@webs/block-register",
  "id": "register",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Register", "es": "Registro" },
  "description": {
    "en": "Public registration orchestrated over the auth core.",
    "es": "Registro público orquestado sobre el núcleo de auth."
  },
  "author": "Webs",
  "license": "MIT",
  "category": "auth",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["content"],
  "settings": {
    "type": "object",
    "title": "Registro",
    "properties": {
      "mode": {
        "type": "string",
        "title": "Modo de registro",
        "enum": ["open", "invite", "both"],
        "default": "open"
      },
      "defaultRole": {
        "type": "string",
        "title": "Rol por defecto",
        "enum": ["user", "editor"],
        "default": "user"
      }
    }
  }
}
