{
  "name": "@webs/block-register",
  "id": "register",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Register", "es": "Registro" },
  "description": {
    "en": "Public registration with pending approval.",
    "es": "Registro público con aprobación pendiente."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["content"],
  "category": "auth",
  "settings": {
    "type": "object",
    "title": "Registro",
    "properties": {
      "requireApproval": { "type": "boolean", "title": "Requerir aprobación", "default": true },
      "inviteOnly": { "type": "boolean", "title": "Solo por invitación", "default": false },
      "defaultRole": { "type": "string", "title": "Rol por defecto", "enum": ["user", "editor"], "default": "user" },
      "sendWelcomeEmail": { "type": "boolean", "title": "Enviar email de bienvenida", "default": true }
    }
  }
}
