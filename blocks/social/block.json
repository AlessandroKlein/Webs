{
  "name": "@webs/block-social",
  "id": "social",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Social Network", "es": "Red social" },
  "description": { "en": "Mini social network (posts, media, likes).", "es": "Mini red social (publicaciones, multimedia, likes)." },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["content"],
  "category": "contenido",
  "settings": {
    "type": "object",
    "title": "Red social",
    "properties": {
      "enabled": { "type": "boolean", "title": "Habilitado", "default": true },
      "allowImages": { "type": "boolean", "title": "Permitir imágenes", "default": true },
      "allowVideos": { "type": "boolean", "title": "Permitir videos", "default": true },
      "maxPostLength": { "type": "number", "title": "Largo máximo de publicación", "default": 500 },
      "moderation": { "type": "string", "title": "Moderación", "enum": ["none", "basic"], "default": "basic" },
      "enableLikes": { "type": "boolean", "title": "Habilitar me gusta", "default": true }
    }
  }
}
