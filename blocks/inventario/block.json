{
  "name": "@webs/block-inventario",
  "id": "inventario",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Inventory", "es": "Inventario" },
  "description": { "en": "Inventory control with stock adjustments and low-stock alerts.", "es": "Control de inventario con ajustes de stock y alertas de stock bajo." },
  "author": "Webs",
  "license": "MIT",
  "category": "negocio",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "permissions": ["inventory.manage"],
  "slots": ["content"],
  "settings": {
    "type": "object",
    "title": "Inventario",
    "properties": {
      "lowStockThreshold": { "type": "number", "title": "Umbral de stock bajo", "default": 5 },
      "trackBySku": { "type": "boolean", "title": "Control por SKU", "default": true }
    }
  }
}
