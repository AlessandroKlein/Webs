{
  "name": "@webs/block-stripe",
  "id": "stripe",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Stripe", "es": "Stripe" },
  "description": { "en": "Card payments via Stripe.", "es": "Pagos con tarjeta vía Stripe." },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["payment"],
  "translations": { "es": { "pay": "Pagar con tarjeta (Stripe)" }, "en": { "pay": "Pay with card (Stripe)" } },
  "settings": {
    "type": "object",
    "title": "Configuración de Stripe",
    "properties": {
      "publishableKey": { "type": "string", "title": "Publishable key (pk_...)" },
      "secretKey": { "type": "string", "title": "Secret key (sk_...)", "x-ui": { "widget": "password", "secret": true } },
      "webhookSecret": { "type": "string", "title": "Webhook signing secret (whsec_...)", "x-ui": { "widget": "password", "secret": true } },
      "primaryColor": { "type": "string", "title": "Color del botón", "x-ui": { "widget": "color" }, "default": "#635bff" }
    }
  }
}
