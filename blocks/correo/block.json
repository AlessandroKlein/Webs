{
  "name": "@webs/block-envio-correo",
  "id": "correo",
  "version": "0.1.0",
  "type": "block",
  "category": "envios",
  "displayName": { "en": "Correo Argentino", "es": "Correo Argentino" },
  "description": {
    "en": "Shipping quotes via Correo Argentino MiCorreo (Basic auth → JWT → /rates).",
    "es": "Cotización de envíos con Correo Argentino MiCorreo (Basic auth → JWT → /rates)."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "provides": ["shipping"],
  "settings": {
    "type": "object",
    "title": "Configuración de Correo Argentino",
    "properties": {
      "enabled": { "type": "boolean", "title": "Habilitado", "default": false },
      "userToken": {
        "type": "string",
        "title": "Usuario (token)",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Usuario para el login Basic auth de MiCorreo.",
            "url": "https://www.correoargentino.com.ar/"
          }
        }
      },
      "passwordToken": {
        "type": "string",
        "title": "Contraseña (token)",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Contraseña para el login Basic auth de MiCorreo.",
            "url": "https://www.correoargentino.com.ar/"
          }
        }
      },
      "customerId": {
        "type": "string",
        "title": "Customer ID",
        "x-ui": {
          "help": {
            "text": "Customer ID de MiCorreo (Correo Argentino).",
            "url": "https://www.correoargentino.com.ar/"
          }
        }
      },
      "originPostalCode": {
        "type": "string",
        "title": "Código postal de origen",
        "default": "1000",
        "x-ui": {
          "help": {
            "text": "Código postal desde el que se despacha.",
            "url": "https://www.correoargentino.com.ar/"
          }
        }
      },
      "baseUrl": {
        "type": "string",
        "title": "URL base",
        "default": "https://api.correoargentino.com.ar/micorreo/v1",
        "x-ui": {
          "help": {
            "text": "URL base de la API MiCorreo.",
            "url": "https://www.correoargentino.com.ar/"
          }
        }
      }
    }
  }
}
