{
  "name": "@webs/block-mercadopago",
  "id": "mercadopago",
  "version": "0.1.0",
  "type": "block",
  "displayName": {
    "en": "Mercado Pago",
    "es": "Mercado Pago"
  },
  "description": {
    "en": "Payments via Mercado Pago (reference block with tokenized secrets and webhook verification).",
    "es": "Pagos con Mercado Pago (bloque de referencia con secretos tokenizados y verificación de webhook)."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["payment"],
  "events": ["mercadopago.payment.created", "mercadopago.payment.approved"],
  "translations": {
    "es": { "pay": "Pagar con Mercado Pago", "checkout": "Finalizar compra" },
    "en": { "pay": "Pay with Mercado Pago", "checkout": "Checkout" },
    "pt": { "pay": "Pagar com Mercado Pago", "checkout": "Finalizar compra" }
  },
  "settings": {
    "type": "object",
    "title": "Configuración de Mercado Pago",
    "properties": {
      "storeName": { "type": "string", "title": "Nombre de la tienda", "default": "Mi Tienda" },
      "environment": {
        "type": "string",
        "title": "Entorno",
        "enum": ["sandbox", "production"],
        "default": "sandbox"
      },
      "publicKey": { "type": "string", "title": "Clave pública (public key)" },
      "accessToken": {
        "type": "string",
        "title": "Access token (privado)",
        "x-ui": { "widget": "password", "secret": true }
      },
      "webhookSecret": {
        "type": "string",
        "title": "Secreto del webhook",
        "x-ui": { "widget": "password", "secret": true }
      },
      "checkoutMode": {
        "type": "string",
        "title": "Modo de checkout",
        "enum": ["embedded", "redirect"],
        "default": "redirect"
      },
      "primaryColor": {
        "type": "string",
        "title": "Color del botón de pago",
        "x-ui": { "widget": "color" },
        "default": "#009ee3"
      }
    }
  }
}
