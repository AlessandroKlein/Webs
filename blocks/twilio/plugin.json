{
  "name": "@webs/block-twilio",
  "id": "twilio",
  "version": "0.1.0",
  "type": "plugin",
  "category": "comunicacion",
  "displayName": {
    "en": "Twilio (SMS/WhatsApp)",
    "es": "Twilio (SMS/WhatsApp)"
  },
  "description": {
    "en": "SMS and WhatsApp notifications via Twilio.",
    "es": "Notificaciones SMS y WhatsApp vía Twilio."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "apiVersion": "1.0.0",
  "provides": [
    "notification"
  ],
  "settings": {
    "type": "object",
    "title": "Configuración de Twilio",
    "properties": {
      "accountSid": {
        "type": "string",
        "title": "Account SID",
        "x-ui": {
          "help": {
            "text": "Account SID de Twilio (consola → Account Info). Identifica tu cuenta para la API.",
            "url": "https://www.twilio.com/docs"
          }
        }
      },
      "authToken": {
        "type": "string",
        "title": "Auth Token",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Auth Token de Twilio. Se usa solo en el servidor para firmar las llamadas a la API.",
            "url": "https://www.twilio.com/docs"
          }
        }
      },
      "fromNumber": {
        "type": "string",
        "title": "Número SMS (ej. +549…)"
      },
      "whatsappFrom": {
        "type": "string",
        "title": "Remitente WhatsApp (ej. whatsapp:+549…)"
      }
    }
  }
}
