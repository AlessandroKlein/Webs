{
  "name": "@webs/block-formularios",
  "id": "formularios",
  "version": "0.1.0",
  "type": "plugin",
  "displayName": {
    "en": "Forms",
    "es": "Formularios"
  },
  "description": {
    "en": "Form builder and responses.",
    "es": "Creador de formularios y respuestas."
  },
  "author": "Webs",
  "license": "MIT",
  "category": "contenido",
  "menu": [
    {
      "id": "admin",
      "label": {
        "en": "Forms",
        "es": "Formularios"
      },
      "path": "/admin/forms",
      "order": 5,
      "target": "admin"
    }
  ],
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": [
    "content"
  ],
  "settings": {
    "type": "object",
    "title": "Formularios",
    "properties": {
      "allowAnonymous": {
        "type": "boolean",
        "title": "Permitir respuestas anónimas",
        "default": true
      },
      "successMessage": {
        "type": "string",
        "title": "Mensaje de éxito",
        "default": "¡Gracias por tu respuesta!"
      },
      "notificationsEmail": {
        "type": "string",
        "title": "Email de notificaciones",
        "format": "email"
      }
    }
  }
}
