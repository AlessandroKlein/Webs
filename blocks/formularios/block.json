{
  "name": "@webs/block-formularios",
  "id": "formularios",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Forms", "es": "Formularios" },
  "description": { "en": "Form builder and responses.", "es": "Creador de formularios y respuestas." },
  "author": "Webs",
  "license": "MIT",
  "category": "contenido",
