{
  "name": "@webs/block-facturacion",
  "id": "facturacion",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Invoicing", "es": "Facturación" },
  "description": { "en": "Invoice generation with fiscal emission (CAE).", "es": "Generación de facturas con emisión fiscal (CAE)." },
  "author": "Webs",
  "license": "MIT",
  "category": "negocio",
  "permissions": ["billing.write"],
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "blockDependencies": ["ecommerce"],
  "slots": ["content"],
  "translations": { "es": { "invoicing": "Facturación" }, "en": { "invoicing": "Invoicing" } },
  "settings": {
    "type": "object",
    "title": "Configuración de facturación",
    "properties": {
      "businessName": { "type": "string", "title": "Razón social" },
      "taxId": { "type": "string", "title": "CUIT/CIF" },
      "taxRate": { "type": "number", "title": "IVA (%)", "default": 21 },
      "invoiceTemplate": {
        "type": "string",
        "title": "Plantilla HTML del comprobante",
        "x-ui": {
          "widget": "textarea",
          "rows": 16,
          "help": { "text": "Plantilla HTML para el comprobante. Placeholders: {{number}} {{customerName}} {{amount}} {{date}} {{cae}} {{type}} {{currency}}. Si está vacía se usa una plantilla por defecto. El PDF se genera imprimiendo este HTML desde el navegador." }
        }
      },
      "taxProvider": { "type": "string", "title": "Proveedor fiscal", "enum": ["local", "afip", "facturante", "tsd"], "default": "local", "x-ui": { "help": { "text": "Local (CAE simulado), AFIP/ARCA (WSFE FECAESolicitar, requiere token+sign), Facturante o TSD. Sin credenciales se usa CAE simulado.", "url": "https://www.afip.gob.ar/ws/WSFE/documentacion/WSFE_v1.pdf" } } },
      "arcaCert": { "type": "string", "title": "Certificado ARCA", "x-ui": { "widget": "password", "secret": true, "help": { "text": "Certificado ARCA/AFIP para firmar las solicitudes al webservice WSFE. Se usa solo en el servidor.", "url": "https://www.afip.gob.ar/ws/WSFE/documentacion/WSFE_v1.pdf" } } },
      "fiscalToken": { "type": "string", "title": "Token de acceso (AFIP TA)", "x-ui": { "widget": "password", "secret": true, "help": { "text": "Token de acceso (TA) devuelto por el webservice de autorización de AFIP. Se usa solo en el servidor.", "url": "https://www.afip.gob.ar/ws/WSFE/documentacion/WSFE_v1.pdf" } } },
      "fiscalSign": { "type": "string", "title": "Sign (AFIP TA)", "x-ui": { "widget": "password", "secret": true, "help": { "text": "Firma (Sign) devuelta por el webservice de autorización de AFIP. Se usa solo en el servidor.", "url": "https://www.afip.gob.ar/ws/WSFE/documentacion/WSFE_v1.pdf" } } },
      "fiscalUsername": { "type": "string", "title": "Usuario fiscal (Facturante/TSD)", "x-ui": { "help": { "text": "Usuario del proveedor fiscal (Facturante o TSD).", "url": "https://www.facturante.com/" } } },
      "fiscalPassword": { "type": "string", "title": "Contraseña fiscal", "x-ui": { "widget": "password", "secret": true, "help": { "text": "Contraseña del proveedor fiscal (Facturante/TSD). Se usa solo en el servidor.", "url": "https://www.facturante.com/" } } },
      "fiscalReseller": { "type": "string", "title": "Reseller (Facturante)", "x-ui": { "help": { "text": "Identificador de reseller para el proveedor Facturante.", "url": "https://www.facturante.com/" } } },
      "fiscalServiceUrl": { "type": "string", "title": "URL del webservice fiscal", "x-ui": { "help": { "text": "URL del webservice fiscal (AFIP WSFE o proveedor). Vacío usa el endpoint por defecto.", "url": "https://www.afip.gob.ar/ws/WSFE/documentacion/WSFE_v1.pdf" } } }
    }
  }
}
