{
  "name": "@webs/block-blog",
  "id": "blog",
  "version": "0.1.0",
  "type": "plugin",
  "displayName": {
    "en": "Blog / CMS",
    "es": "Blog / CMS"
  },
  "description": {
    "en": "Posts, categories and tags.",
    "es": "Publicaciones, categorías y etiquetas."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": [
    "content"
  ],
  "category": "contenido",
  "menu": [
    {
      "id": "admin",
      "label": {
        "en": "Blog",
        "es": "Blog"
      },
      "path": "/admin/blog",
      "order": 1,
      "target": "admin"
    }
  ],
  "settings": {
    "type": "object",
    "title": "Blog",
    "properties": {
      "postsPerPage": {
        "type": "number",
        "title": "Publicaciones por página",
        "default": 10
      },
      "showAuthor": {
        "type": "boolean",
        "title": "Mostrar autor",
        "default": true
      },
      "showDate": {
        "type": "boolean",
        "title": "Mostrar fecha",
        "default": true
      },
      "defaultCategory": {
        "type": "string",
        "title": "Categoría por defecto",
        "default": ""
      },
      "allowComments": {
        "type": "boolean",
        "title": "Permitir comentarios",
        "default": true
      }
    }
  }
}
