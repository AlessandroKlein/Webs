{
  "name": "@webs/block-analytics",
  "id": "analytics",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Analytics", "es": "Analítica" },
  "description": { "en": "Business metrics, revenue and page view tracking.", "es": "Métricas de negocio, ingresos y seguimiento de visitas." },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["footer"],
  "category": "seo",
  "settings": {
    "type": "object",
    "title": "Analítica",
    "properties": {
      "enabled": { "type": "boolean", "title": "Registrar visitas", "default": true },
      "provider": { "type": "string", "title": "Proveedor", "enum": ["internal", "google-analytics", "plausible", "matomo"], "default": "internal", "x-ui": { "help": { "text": "GA4 (Measurement Protocol), Plausible, Matomo o el interno. El interno no envía datos a terceros.", "url": "https://developers.google.com/analytics/devguides/collection/protocol/ga4" } } },
      "trackingId": { "type": "string", "title": "ID de seguimiento", "x-ui": { "widget": "password", "secret": true } },
      "apiSecret": { "type": "string", "title": "API Secret (GA4)", "x-ui": { "widget": "password", "secret": true } },
      "domain": { "type": "string", "title": "Dominio (Plausible)" },
      "serverUrl": { "type": "string", "title": "URL del servidor (Plausible/Matomo)" },
      "siteId": { "type": "string", "title": "ID de sitio (Matomo)" },
      "trackPageViews": { "type": "boolean", "title": "Registrar vistas de página", "default": true },
      "anonymizeIp": { "type": "boolean", "title": "Anonimizar IP", "default": true }
    }
  }
}
