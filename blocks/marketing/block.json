{
  "name": "@webs/block-marketing",
  "id": "marketing",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Marketing", "es": "Marketing" },
  "description": { "en": "Discount coupons and promotions.", "es": "Cupones de descuento y promociones." },
  "author": "Webs",
  "license": "MIT",
  "category": "marketing",
  "entry": "./dist/server.js",
  "apiVersion": "1.0.0",
  "blockDependencies": ["ecommerce"],
  "settings": {
    "type": "object",
    "title": "Marketing",
    "properties": {
      "enableCoupons": { "type": "boolean", "title": "Habilitar cupones", "default": false },
      "defaultDiscountPercent": { "type": "number", "title": "Descuento por defecto (%)", "default": 10 },
      "pointsPerPurchase": { "type": "number", "title": "Puntos por compra", "default": 1 },
      "coupons": {
        "type": "array",
        "title": "Cupones",
        "items": { "type": "object", "properties": { "code": { "type": "string" }, "percent": { "type": "number" } } },
        "default": []
      }
    }
  }
}
