{
  "name": "@webs/block-marketing",
  "id": "marketing",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Marketing", "es": "Marketing" },
  "description": { "en": "Discount coupons, email campaigns and metrics.", "es": "Cupones de descuento, campañas de email y métricas." },
  "author": "Webs",
  "license": "MIT",
  "category": "marketing",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "blockDependencies": ["ecommerce"],
  "slots": ["content"],
  "translations": { "es": { "marketing": "Marketing" }, "en": { "marketing": "Marketing" } },
  "settings": {
    "type": "object",
    "title": "Marketing",
    "properties": {
      "defaultDiscountPercent": { "type": "number", "title": "Descuento por defecto (%)", "default": 10 },
      "pointsPerPurchase": { "type": "number", "title": "Puntos por compra", "default": 1 },
      "emailProvider": { "type": "string", "title": "Proveedor de email", "enum": ["internal", "mailchimp", "resend", "sendgrid"], "default": "internal" },
      "emailApiKey": { "type": "string", "title": "API Key de email", "x-ui": { "widget": "password", "secret": true } }
    }
  }
}
