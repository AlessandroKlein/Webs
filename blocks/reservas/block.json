{
  "name": "@webs/block-reservas",
  "id": "reservas",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Bookings", "es": "Reservas y turnos" },
  "description": { "en": "Appointments and bookings.", "es": "Citas y reservas." },
  "author": "Webs",
  "license": "MIT",
  "category": "negocio",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["content"],
  "settings": {
    "type": "object",
    "title": "Reservas",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Proveedor",
        "enum": ["local", "google", "caldav"],
        "default": "local"
      },
      "reminderEmail": { "type": "boolean", "title": "Recordatorio por email", "default": false },
      "leadTimeHours": { "type": "number", "title": "Antelación (horas)", "default": 24 },
      "cancelPolicyHours": { "type": "number", "title": "Política de cancelación (horas)", "default": 24 },
      "defaultSlots": { "type": "number", "title": "Cupos por defecto", "default": 10 },
      "recurrenceLimit": { "type": "number", "title": "Máximo de repeticiones", "default": 12 },
      "services": {
        "type": "array",
        "title": "Servicios",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "duration": { "type": "number" },
            "price": { "type": "number" }
          }
        },
        "default": []
      }
    }
  }
}
