{
  "name": "@webs/block-carrito",
  "id": "carrito",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Cart / Store", "es": "Carrito / Tienda" },
  "description": { "en": "Product catalog with cart and checkout.", "es": "Catálogo de productos con carrito y checkout." },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "blockDependencies": ["mercadopago"],
  "slots": ["content"],
  "translations": { "es": { "add": "Agregar", "checkout": "Pagar", "cart": "Carrito", "total": "Total" }, "en": { "add": "Add", "checkout": "Checkout", "cart": "Cart", "total": "Total" } },
  "settings": {
    "type": "object",
    "title": "Configuración de la tienda",
    "properties": {
      "title": { "type": "string", "title": "Título", "default": "Tienda" },
      "catalog": {
        "type": "array",
        "title": "Catálogo",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "price": { "type": "number" },
            "stock": { "type": "number" }
          }
        },
        "default": []
      }
    }
  }
}
