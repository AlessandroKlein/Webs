{
  "name": "@webs/block-chat-ia",
  "id": "chat-ia",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "AI Chat", "es": "Chat con IA" },
  "description": { "en": "AI chat (configurable provider).", "es": "Chat con IA (proveedor configurable)." },
  "author": "Webs",
  "license": "MIT",
  "category": "comunicacion",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["content"],
  "settings": {
    "type": "object",
    "title": "Chat IA",
    "properties": {
      "provider": { "type": "string", "title": "Proveedor", "enum": ["openai", "anthropic", "gemini", "ollama", "mistral", "groq", "openrouter"], "default": "openai", "x-ui": { "help": { "text": "OpenAI (Chat Completions), Anthropic (Messages), Google Gemini (generateContent), Ollama local o proveedores OpenAI-compatibles (Mistral, Groq, OpenRouter). Sin API key se usa una respuesta simulada.", "url": "https://platform.openai.com/docs/api-reference/chat" } } },
      "model": { "type": "string", "title": "Modelo", "default": "gpt-4o-mini" },
      "apiKey": { "type": "string", "title": "API Key", "x-ui": { "widget": "password" } },
      "baseUrl": { "type": "string", "title": "URL base (OpenAI-compatible)" },
      "temperature": { "type": "number", "title": "Temperatura" },
      "ollamaUrl": { "type": "string", "title": "URL de Ollama", "default": "http://localhost:11434" },
      "room": { "type": "string", "title": "Sala / room", "default": "general" }
    }
  }
}
