{
  "name": "@webs/block-social-login",
  "id": "social-login",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Social Login", "es": "Login social" },
  "description": {
    "en": "Sign in with social providers.",
    "es": "Inicio de sesión con redes sociales."
  },
  "author": "Webs",
  "license": "MIT",
  "category": "auth",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["content"],
  "settings": {
    "type": "object",
    "title": "Social Login",
    "properties": {
      "providers": {
        "type": "array",
        "title": "Proveedores",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "title": "ID" },
            "name": { "type": "string", "title": "Nombre" },
            "enabled": { "type": "boolean", "title": "Habilitado", "default": false },
            "clientId": { "type": "string", "title": "Client ID" },
            "clientSecret": { "type": "string", "title": "Client Secret", "x-ui": { "widget": "password" } },
            "redirectUri": { "type": "string", "title": "URI de redirección" }
          }
        },
        "default": [
          { "id": "google", "name": "Google", "enabled": false, "clientId": "", "clientSecret": "", "redirectUri": "" },
          { "id": "facebook", "name": "Facebook", "enabled": false, "clientId": "", "clientSecret": "", "redirectUri": "" },
          { "id": "apple", "name": "Apple", "enabled": false, "clientId": "", "clientSecret": "", "redirectUri": "" },
          { "id": "github", "name": "GitHub", "enabled": false, "clientId": "", "clientSecret": "", "redirectUri": "" }
        ]
      },
      "autoLinkByEmail": { "type": "boolean", "title": "Vincular por email automáticamente", "default": true }
    }
  }
}
