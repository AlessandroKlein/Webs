{
  "name": "@webs/block-social-login",
  "id": "social-login",
  "version": "0.1.0",
  "type": "plugin",
  "displayName": {
    "en": "Social Login",
    "es": "Login social"
  },
  "description": {
    "en": "Sign in with social providers.",
    "es": "Inicio de sesión con redes sociales."
  },
  "author": "Webs",
  "license": "MIT",
  "category": "auth",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": [
    "content"
  ],
  "settings": {
    "type": "object",
    "title": "Social Login",
    "properties": {
      "providers": {
        "type": "array",
        "title": "Proveedores",
        "x-ui": {
          "help": {
            "text": "Proveedores de login social (Google, Facebook, Apple, GitHub). Configurá Client ID/Secret en la consola de cada proveedor y usá la URI de redirección de tu sitio.",
            "url": "https://developers.google.com/identity/protocols/oauth2"
          }
        },
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "ID"
            },
            "name": {
              "type": "string",
              "title": "Nombre"
            },
            "enabled": {
              "type": "boolean",
              "title": "Habilitado",
              "default": false
            },
            "clientId": {
              "type": "string",
              "title": "Client ID",
              "x-ui": {
                "help": {
                  "text": "Client ID de la app OAuth del proveedor. No es secreto.",
                  "url": "https://developers.google.com/identity/protocols/oauth2"
                }
              }
            },
            "clientSecret": {
              "type": "string",
              "title": "Client Secret",
              "x-ui": {
                "widget": "password",
                "help": {
                  "text": "Client Secret de la app OAuth del proveedor. Se usa solo en el servidor.",
                  "url": "https://developers.google.com/identity/protocols/oauth2"
                }
              }
            },
            "redirectUri": {
              "type": "string",
              "title": "URI de redirección",
              "x-ui": {
                "help": {
                  "text": "URI de callback (callback URL) que registraste en el proveedor. Debe coincidir exactamente.",
                  "url": "https://developers.google.com/identity/protocols/oauth2"
                }
              }
            }
          }
        },
        "default": [
          {
            "id": "google",
            "name": "Google",
            "enabled": false,
            "clientId": "",
            "clientSecret": "",
            "redirectUri": ""
          },
          {
            "id": "facebook",
            "name": "Facebook",
            "enabled": false,
            "clientId": "",
            "clientSecret": "",
            "redirectUri": ""
          },
          {
            "id": "apple",
            "name": "Apple",
            "enabled": false,
            "clientId": "",
            "clientSecret": "",
            "redirectUri": ""
          },
          {
            "id": "github",
            "name": "GitHub",
            "enabled": false,
            "clientId": "",
            "clientSecret": "",
            "redirectUri": ""
          }
        ]
      },
      "autoLinkByEmail": {
        "type": "boolean",
        "title": "Vincular por email automáticamente",
        "default": true
      }
    }
  }
}
