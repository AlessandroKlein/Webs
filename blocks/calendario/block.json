{
  "name": "@webs/block-calendario",
  "id": "calendario",
  "version": "0.1.0",
  "type": "block",
  "displayName": { "en": "Calendar", "es": "Calendario" },
  "description": { "en": "Calendar for events and activities.", "es": "Calendario para turnos y actividades." },
  "author": "Webs",
  "license": "MIT",
  "category": "negocio",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": ["content"],
  "settings": {
    "type": "object",
    "title": "Calendario",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Proveedor",
        "enum": ["local", "google", "caldav"],
        "default": "local"
      },
      "timezone": { "type": "string", "title": "Zona horaria", "default": "America/Argentina/Buenos_Aires" },
      "workingHoursStart": { "type": "string", "title": "Inicio de jornada", "default": "09:00" },
      "workingHoursEnd": { "type": "string", "title": "Fin de jornada", "default": "18:00" },
      "calendarApiKey": {
        "type": "string",
        "title": "API Key del calendario",
        "x-ui": { "widget": "password", "secret": true }
      },
      "calendarAccessToken": {
        "type": "string",
        "title": "Token OAuth2 (Google Calendar)",
        "x-ui": { "widget": "password", "secret": true }
      },
      "calendarId": { "type": "string", "title": "ID del calendario (Google)", "default": "primary" },
      "caldavUrl": { "type": "string", "title": "URL de colección CalDAV" },
      "caldavUsername": { "type": "string", "title": "Usuario CalDAV" },
      "caldavPassword": {
        "type": "string",
        "title": "Contraseña CalDAV",
        "x-ui": { "widget": "password", "secret": true }
      }
    }
  }
}
