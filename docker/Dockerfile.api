# syntax=docker/dockerfile:1
# API de Webs (Fastify). Contexto de build = raíz del monorepo.

FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
RUN apt-get update -y && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Dependencias (workspace completo)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json .npmrc ./
COPY apps ./apps
COPY packages ./packages
COPY blocks ./blocks
COPY scripts ./scripts
COPY templates ./templates
RUN pnpm install --frozen-lockfile

# Generar cliente Prisma (PostgreSQL por defecto) y compilar todo el monorepo
RUN pnpm --filter @webs/api exec prisma generate
RUN pnpm -r build

ENV NODE_ENV=production \
    APP_DIR=/app/apps/api \
    DATA_DIR=/app/data
EXPOSE 4000

# En modo instalación la API arranca sin base de datos y expone el asistente en
# /api/v1/setup; la base de datos se configura desde la UI y queda en DATA_DIR.
CMD ["node", "apps/api/dist/index.js"]
