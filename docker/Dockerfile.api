# syntax=docker/dockerfile:1
# API de Webs (Fastify). Contexto de build = raíz del monorepo.

FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
RUN apt-get update -y && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Dependencias (workspace completo)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json .npmrc ./
COPY apps ./apps
COPY packages ./packages
COPY plugins ./plugins
COPY scripts ./scripts
COPY templates ./templates
RUN pnpm install --frozen-lockfile

# Generar cliente Prisma (PostgreSQL por defecto) y compilar todo el monorepo
RUN pnpm --filter @webs/api exec prisma generate
RUN pnpm -r build

# Entrypoint de arranque "llave en mano": migraciones + seed + estado + server.
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV NODE_ENV=production \
    APP_DIR=/app/apps/api \
    DATA_DIR=/app/data
EXPOSE 4000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "apps/api/dist/index.js"]
