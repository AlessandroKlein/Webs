{
  "name": "@licensify/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Licenciamiento local, offline y anti-reverse-engineering (vendorizado en el monorepo Webs): firma Ed25519, cifrado AES-256-GCM con clave partida, node-locking por fingerprint y claves de activación Crockford.",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@webs/config": "workspace:*",
    "eslint": "^9.13.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
