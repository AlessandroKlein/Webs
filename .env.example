# =============================================================
# Webs — variables de entorno de ejemplo (raíz del monorepo).
# Cada app tiene su propio .env.example con su superficie propia.
# Copiar a .env y ajustar antes de levantar en producción.
# =============================================================

# Entorno de ejecución (development | test | production)
NODE_ENV=development

# Puerto por defecto de la API
API_PORT=4000
# Puerto por defecto del frontend (dev server)
WEB_PORT=5173

# Base de datos PostgreSQL
DATABASE_URL=postgresql://webs:webs@localhost:5432/webs?schema=public

# Redis (caché, pub/sub, sesiones y WebSocket en cluster). Opcional en dev.
REDIS_URL=redis://localhost:6379

# Secretos JWT (usar valores largos y aleatorios en producción)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production

# Origen permitido para CORS (el frontend)
CORS_ORIGIN=http://localhost:5173
