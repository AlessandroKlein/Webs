{
  "name": "@webs/plugin-payway",
  "id": "payway",
  "version": "0.1.0",
  "type": "plugin",
  "category": "pagos",
  "displayName": {
    "en": "Payway / Decidir",
    "es": "Payway / Decidir"
  },
  "description": {
    "en": "Payments via Payway (Decidir 2.0).",
    "es": "Pagos con Payway (Decidir 2.0)."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "provides": [
    "payment"
  ],
  "slots": [
    "payment"
  ],
  "translations": {
    "es": {
      "pay": "Pagar con Payway"
    },
    "en": {
      "pay": "Pay with Payway"
    }
  },
  "settings": {
    "type": "object",
    "title": "Configuración de Payway",
    "properties": {
      "siteId": {
        "type": "string",
        "title": "Site ID",
        "x-ui": {
          "help": {
            "text": "Site ID de Payway (Decidir 2.0) que identifica tu comercio.",
            "url": "https://developers.payway.com.ar/"
          }
        }
      },
      "apiKey": {
        "type": "string",
        "title": "API Key",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "API Key de Payway para autenticar las llamadas a la API. Se usa solo en el servidor.",
            "url": "https://developers.payway.com.ar/"
          }
        }
      },
      "webhookSecret": {
        "type": "string",
        "title": "Secreto del webhook",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Secreto para validar la firma del webhook. Si desactivás la verificación en Ajustes → Pagos, no se usa.",
            "url": "https://developers.payway.com.ar/"
          }
        }
      },
      "environment": {
        "type": "string",
        "title": "Entorno",
        "enum": [
          "sandbox",
          "production"
        ],
        "default": "sandbox"
      },
      "primaryColor": {
        "type": "string",
        "title": "Color del botón",
        "x-ui": {
          "widget": "color"
        },
        "default": "#004b93"
      }
    }
  }
}
