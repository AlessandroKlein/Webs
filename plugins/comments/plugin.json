{
  "name": "@webs/plugin-comments",
  "id": "comments",
  "version": "0.1.0",
  "type": "plugin",
  "displayName": {
    "en": "Comments & Ratings",
    "es": "Comentarios y valoraciones"
  },
  "description": {
    "en": "Star ratings and reviews.",
    "es": "Valoraciones con estrellas y reseñas."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": [
    "content"
  ],
  "category": "social",
  "settings": {
    "type": "object",
    "title": "Comentarios",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Habilitado",
        "default": true
      },
      "allowAnonymous": {
        "type": "boolean",
        "title": "Permitir anónimos",
        "default": true
      },
      "defaultRating": {
        "type": "integer",
        "title": "Valoración por defecto",
        "minimum": 1,
        "maximum": 5,
        "default": 5
      },
      "maxRating": {
        "type": "integer",
        "title": "Valoración máxima",
        "minimum": 1,
        "maximum": 5,
        "default": 5
      },
      "moderation": {
        "type": "string",
        "title": "Moderación",
        "enum": [
          "none",
          "basic"
        ],
        "default": "none"
      }
    }
  }
}
