{
  "name": "@webs/plugin-academia",
  "id": "academia",
  "version": "0.1.0",
  "type": "plugin",
  "displayName": {
    "en": "Academy / LMS",
    "es": "Academia / LMS"
  },
  "description": {
    "en": "Courses, lessons and progress.",
    "es": "Cursos, lecciones y progreso."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": [
    "content"
  ],
  "category": "educacion",
  "permissions": [
    "course.manage"
  ],
  "settings": {
    "type": "object",
    "title": "Academia",
    "properties": {
      "allowEnroll": {
        "type": "boolean",
        "title": "Permitir inscripción",
        "default": true
      },
      "certificateEnabled": {
        "type": "boolean",
        "title": "Certificados habilitados",
        "default": false
      },
      "passingScore": {
        "type": "integer",
        "title": "Nota de aprobación",
        "minimum": 0,
        "maximum": 100,
        "default": 70
      },
      "defaultLevel": {
        "type": "string",
        "title": "Nivel por defecto",
        "enum": [
          "básico",
          "intermedio",
          "avanzado"
        ],
        "default": "básico"
      }
    }
  },
  "repository": "https://github.com/AlessandroKlein/Webs"
}
