{
  "name": "@webs/plugin-chat",
  "id": "chat",
  "version": "0.1.0",
  "type": "plugin",
  "displayName": {
    "en": "Direct Messaging",
    "es": "Mensajería directa"
  },
  "description": {
    "en": "Direct messaging between users.",
    "es": "Mensajería directa entre usuarios."
  },
  "author": "Webs",
  "license": "MIT",
  "category": "comunicacion",
  "menu": [
    {
      "id": "admin",
      "label": {
        "en": "Chat",
        "es": "Chat"
      },
      "path": "/admin/chat",
      "order": 3,
      "target": "admin"
    }
  ],
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": [
    "content"
  ],
  "events": [
    "chat.message"
  ],
  "settings": {
    "type": "object",
    "title": "Chat",
    "properties": {
      "room": {
        "type": "string",
        "title": "Sala",
        "default": "general"
      },
      "allowCommunities": {
        "type": "boolean",
        "title": "Permitir comunidades",
        "default": false
      },
      "moderation": {
        "type": "string",
        "title": "Moderación",
        "enum": [
          "none",
          "basic"
        ],
        "default": "none"
      },
      "maxMessageLength": {
        "type": "number",
        "title": "Longitud máxima del mensaje",
        "default": 500
      }
    }
  }
}
