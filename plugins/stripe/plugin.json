{
  "name": "@webs/plugin-stripe",
  "id": "stripe",
  "version": "0.1.0",
  "type": "plugin",
  "category": "pagos",
  "displayName": {
    "en": "Stripe",
    "es": "Stripe"
  },
  "description": {
    "en": "Card payments via Stripe.",
    "es": "Pagos con tarjeta vía Stripe."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "provides": [
    "payment"
  ],
  "slots": [
    "payment"
  ],
  "translations": {
    "es": {
      "pay": "Pagar con tarjeta (Stripe)"
    },
    "en": {
      "pay": "Pay with card (Stripe)"
    }
  },
  "settings": {
    "type": "object",
    "title": "Configuración de Stripe",
    "properties": {
      "publishableKey": {
        "type": "string",
        "title": "Publishable key (pk_...)",
        "x-ui": {
          "help": {
            "text": "Clave pública (pk_...) que se envía al cliente para Stripe.js. No es secreta.",
            "url": "https://dashboard.stripe.com/apikeys"
          }
        }
      },
      "secretKey": {
        "type": "string",
        "title": "Secret key (sk_...)",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Clave secreta (sk_...) que se usa solo en el servidor para crear Payment Intents.",
            "url": "https://dashboard.stripe.com/apikeys"
          }
        }
      },
      "webhookSecret": {
        "type": "string",
        "title": "Webhook signing secret (whsec_...)",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Secreto de firma (whsec_...) para validar la cabecera stripe-signature. Si desactivás la verificación en Ajustes → Pagos, no se usa.",
            "url": "https://stripe.com/docs/webhooks/signatures"
          }
        }
      },
      "primaryColor": {
        "type": "string",
        "title": "Color del botón",
        "x-ui": {
          "widget": "color"
        },
        "default": "#635bff"
      }
    }
  },
  "repository": "https://github.com/AlessandroKlein/Webs"
}
