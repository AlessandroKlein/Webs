{
  "name": "@webs/plugin-push",
  "id": "push",
  "version": "0.1.0",
  "type": "plugin",
  "category": "comunicacion",
  "displayName": {
    "en": "Web Push",
    "es": "Notificaciones push"
  },
  "description": {
    "en": "Web push notifications (reference).",
    "es": "Notificaciones push web (referencia)."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "provides": [
    "notification"
  ],
  "pluginDependencies": [
    "notificaciones"
  ],
  "slots": [
    "content"
  ],
  "translations": {
    "es": {
      "enable": "Activar notificaciones"
    },
    "en": {
      "enable": "Enable notifications"
    }
  },
  "settings": {
    "type": "object",
    "title": "Configuración de push",
    "properties": {
      "publicKey": {
        "type": "string",
        "title": "Clave pública VAPID",
        "x-ui": {
          "help": {
            "text": "Clave pública VAPID (Web Push). No es secreta; se envía al navegador para suscribirse.",
            "url": "https://developer.mozilla.org/en-US/docs/Web/API/Push_API"
          }
        }
      },
      "privateKey": {
        "type": "string",
        "title": "Clave privada VAPID",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Clave privada VAPID (Web Push). Se usa solo en el servidor para firmar las suscripciones push.",
            "url": "https://developer.mozilla.org/en-US/docs/Web/API/Push_API"
          }
        }
      }
    }
  }
}
