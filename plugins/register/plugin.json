{
  "name": "@webs/plugin-register",
  "id": "register",
  "version": "0.1.0",
  "type": "plugin",
  "displayName": {
    "en": "Register",
    "es": "Registro"
  },
  "description": {
    "en": "Public registration orchestrated over the auth core.",
    "es": "Registro público orquestado sobre el núcleo de auth."
  },
  "author": "Webs",
  "license": "MIT",
  "category": "auth",
  "menu": [
    {
      "id": "admin",
      "label": {
        "en": "Registration / Login",
        "es": "Registro / Login"
      },
      "path": "/admin/auth",
      "order": 10,
      "target": "admin"
    }
  ],
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "slots": [
    "content"
  ],
  "settings": {
    "type": "object",
    "title": "Registro",
    "properties": {
      "mode": {
        "type": "string",
        "title": "Modo de registro",
        "enum": [
          "open",
          "invite",
          "both"
        ],
        "default": "open"
      },
      "defaultRole": {
        "type": "string",
        "title": "Rol por defecto",
        "enum": [
          "user",
          "editor"
        ],
        "default": "user"
      }
    }
  }
}
