{
  "name": "@webs/plugin-pos",
  "id": "pos",
  "version": "0.1.0",
  "type": "plugin",
  "category": "pagos",
  "permissions": [
    "sales.manage"
  ],
  "displayName": {
    "en": "Cash on delivery / POS",
    "es": "Contra entrega / POS"
  },
  "description": {
    "en": "Cash on delivery and physical card readers (mPOS / Point / Payway terminals).",
    "es": "Pagos contra entrega y lectores de tarjeta (mPOS / Point / terminales Payway)."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "provides": [
    "payment"
  ],
  "slots": [
    "payment"
  ],
  "translations": {
    "es": {
      "pay": "Pagar contra entrega",
      "terminal": "Cobrar en el lector"
    },
    "en": {
      "pay": "Cash on delivery",
      "terminal": "Charge on terminal"
    }
  },
  "settings": {
    "type": "object",
    "title": "Configuración de cobro presencial",
    "properties": {
      "mode": {
        "type": "string",
        "title": "Modo",
        "enum": [
          "cash",
          "terminal"
        ],
        "default": "cash"
      },
      "terminalId": {
        "type": "string",
        "title": "ID del terminal (Point/Payway)",
        "x-ui": {
          "help": {
            "text": "ID del lector físico (Point de Mercado Pago o terminal Payway) donde se inicia el cobro presencial.",
            "url": "https://www.mercadopago.com.ar/developers/es"
          }
        }
      },
      "apiKey": {
        "type": "string",
        "title": "API Key",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "API Key del lector para autenticar los cobros presenciales. Se usa solo en el servidor.",
            "url": "https://www.mercadopago.com.ar/developers/es"
          }
        }
      },
      "webhookSecret": {
        "type": "string",
        "title": "Secreto del webhook",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Secreto para validar la firma del webhook del lector. Si desactivás la verificación en Ajustes → Pagos, no se usa.",
            "url": "https://www.mercadopago.com.ar/developers/es"
          }
        }
      },
      "primaryColor": {
        "type": "string",
        "title": "Color del botón",
        "x-ui": {
          "widget": "color"
        },
        "default": "#16a34a"
      }
    }
  },
  "repository": "https://github.com/AlessandroKlein/Webs"
}
