{
  "name": "@webs/plugin-sema",
  "id": "sema",
  "version": "0.1.0",
  "type": "plugin",
  "displayName": {
    "en": "SEMA",
    "es": "SEMA"
  },
  "description": {
    "en": "SEMA environmental/energy monitoring node: REST telemetry and local time series.",
    "es": "Nodo de monitoreo ambiental/energía SEMA: telemetría REST y serie temporal local."
  },
  "author": "Webs",
  "license": "MIT",
  "category": "integracion",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "settings": {
    "type": "object",
    "title": "SEMA",
    "properties": {
      "defaultPollIntervalMs": {
        "type": "integer",
        "title": "Intervalo de sondeo por defecto (ms)",
        "default": 60000
      },
      "ssrfAllowlist": {
        "type": "array",
        "title": "Hosts/IP permitidos adicionales (SSRF)",
        "x-ui": {
          "help": {
            "text": "El sondeo ya bloquea loopback/direcciones privadas. Añadí acá hosts internos que quieras permitir explícitamente."
          }
        },
        "items": { "type": "string" },
        "default": []
      }
    }
  },
  "repository": "https://github.com/AlessandroKlein/Webs"
}
