{
  "name": "@webs/plugin-marketing",
  "id": "marketing",
  "version": "0.1.0",
  "type": "plugin",
  "displayName": {
    "en": "Marketing",
    "es": "Marketing"
  },
  "description": {
    "en": "Discount coupons, email campaigns and metrics.",
    "es": "Cupones de descuento, campañas de email y métricas."
  },
  "author": "Webs",
  "license": "MIT",
  "category": "marketing",
  "permissions": [
    "marketing.manage"
  ],
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "pluginDependencies": [
    "ecommerce"
  ],
  "slots": [
    "content"
  ],
  "translations": {
    "es": {
      "marketing": "Marketing"
    },
    "en": {
      "marketing": "Marketing"
    }
  },
  "settings": {
    "type": "object",
    "title": "Marketing",
    "properties": {
      "defaultDiscountPercent": {
        "type": "number",
        "title": "Descuento por defecto (%)",
        "default": 10
      },
      "pointsPerPurchase": {
        "type": "number",
        "title": "Puntos por compra",
        "default": 1
      },
      "emailProvider": {
        "type": "string",
        "title": "Proveedor de email",
        "enum": [
          "internal",
          "mailchimp",
          "resend",
          "sendgrid"
        ],
        "default": "internal",
        "x-ui": {
          "help": {
            "text": "Proveedor de email marketing: interno (SMTP), Mailchimp, Resend o SendGrid. Sin API Key se usa el SMTP interno.",
            "url": "https://resend.com/docs"
          }
        }
      },
      "emailApiKey": {
        "type": "string",
        "title": "API Key de email",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "API Key del proveedor de email marketing (Mailchimp/Resend/SendGrid). Se usa solo en el servidor.",
            "url": "https://resend.com/docs"
          }
        }
      }
    }
  }
}
