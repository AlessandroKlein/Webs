{
  "name": "@webs/plugin-paypal",
  "id": "paypal",
  "version": "0.1.0",
  "type": "plugin",
  "category": "pagos",
  "displayName": {
    "en": "PayPal",
    "es": "PayPal"
  },
  "description": {
    "en": "Payments via PayPal.",
    "es": "Pagos con PayPal."
  },
  "author": "Webs",
  "license": "MIT",
  "entry": "./dist/server.js",
  "clientEntry": "./dist/client.js",
  "apiVersion": "1.0.0",
  "provides": [
    "payment"
  ],
  "slots": [
    "payment"
  ],
  "translations": {
    "es": {
      "pay": "Pagar con PayPal"
    },
    "en": {
      "pay": "Pay with PayPal"
    }
  },
  "settings": {
    "type": "object",
    "title": "Configuración de PayPal",
    "properties": {
      "clientId": {
        "type": "string",
        "title": "Client ID",
        "x-ui": {
          "help": {
            "text": "Client ID de la app de PayPal (developer.paypal.com). No es secreto; se expone al cliente para el SDK.",
            "url": "https://developer.paypal.com/"
          }
        }
      },
      "clientSecret": {
        "type": "string",
        "title": "Client Secret",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Client Secret de PayPal. Se usa solo en el servidor para obtener el token de acceso.",
            "url": "https://developer.paypal.com/"
          }
        }
      },
      "webhookId": {
        "type": "string",
        "title": "Webhook ID",
        "x-ui": {
          "help": {
            "text": "ID del webhook registrado en PayPal (se usa junto con la firma PAYPAL-TRANSMISSION-SIG).",
            "url": "https://developer.paypal.com/docs/api-basics/notifications/webhooks/"
          }
        }
      },
      "webhookSecret": {
        "type": "string",
        "title": "Secreto del webhook",
        "x-ui": {
          "widget": "password",
          "secret": true,
          "help": {
            "text": "Secreto para validar la firma del webhook. Si desactivás la verificación en Ajustes → Pagos, no se usa.",
            "url": "https://developer.paypal.com/docs/api-basics/notifications/webhooks/"
          }
        }
      },
      "environment": {
        "type": "string",
        "title": "Entorno",
        "enum": [
          "sandbox",
          "live"
        ],
        "default": "sandbox"
      },
      "primaryColor": {
        "type": "string",
        "title": "Color del botón",
        "x-ui": {
          "widget": "color"
        },
        "default": "#ffc439"
      }
    }
  },
  "repository": "https://github.com/AlessandroKlein/Webs",
  "feature": "payments"
}
